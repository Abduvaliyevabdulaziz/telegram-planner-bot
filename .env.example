# =============================================================================
# Telegram Bot Configuration
# =============================================================================

# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_123456

# Your Personal Telegram User ID (numeric).
# Only this User ID will be permitted to access and control the bot.
# Obtain your ID by sending any message to @userinfobot or @raw_data_bot on Telegram.
ADMIN_USER_ID=123456789

# Daily spending threshold in Uzbek So'm (UZS). Default: 70,000 UZS.
DAILY_BUDGET_LIMIT=70000

# SQLite database file name (stored in project root by default)
DB_FILE_NAME=planner_bot.db

# Nightly planning prompt time (Asia/Tashkent local time, 24-hour format). Default: 21:00 (9:00 PM)
EVENING_PLAN_HOUR=21
EVENING_PLAN_MINUTE=0

# Morning briefing delivery time (Asia/Tashkent local time, 24-hour format). Default: 09:00 (9:00 AM)
MORNING_BRIEF_HOUR=9
MORNING_BRIEF_MINUTE=0
